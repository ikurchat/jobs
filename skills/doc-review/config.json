{
  "formatting": {
    "font_name": "Times New Roman",
    "font_size_pt": 14,
    "title_font_size_pt": 12,
    "alignment": "justify",
    "line_spacing": 1.15,
    "first_line_indent_cm": 1.25,
    "space_after_pt": 0,
    "space_before_pt": 0
  },

  "page": {
    "width_cm": 21.0,
    "height_cm": 29.7,
    "margin_left_cm": 3.0,
    "margin_right_cm": 1.0,
    "margin_top_cm": 2.0,
    "margin_bottom_cm": 2.0,
    "page_number_font_size_pt": 12
  },

  "structure": {
    "header": {
      "type": "table",
      "rows": 1,
      "cols": 2,
      "borders": false,
      "bold": false,
      "left_cell": "title",
      "right_cell": "addressee"
    },
    "body": {
      "blocks": ["resume", "details", "conclusions"],
      "separator": "none",
      "visible_subheaders": false
    },
    "appendix": {
      "type": "table",
      "rows": 1,
      "cols": 2,
      "borders": false,
      "left_cell_text": "Приложение:",
      "left_col_width": "auto_fit",
      "right_cell_format": "numbered_list"
    },
    "signature": {
      "type": "table",
      "rows": 1,
      "cols": 2,
      "borders": false,
      "left_cell": "position",
      "left_cell_alignment": "left",
      "right_cell": "full_name",
      "right_cell_alignment": "right"
    },
    "footer": {
      "format": "two_lines",
      "content_template": "{executor_name}\n{executor_phone}",
      "font_size_pt": 12,
      "line_spacing": "single",
      "empty_line_after": true,
      "only_on_signature_page": true
    }
  },

  "executors": {
    "Панков Иван Юрьевич": "1606",
    "Татаров Евгений Иванович": "1616",
    "Сошников Андрей Николаевич": "1616",
    "Кулиш Анатолий Сергеевич": "1616",
    "Меликян Нарек Айкович": "1616"
  },

  "known_abbreviations": ["СИТ", "ЦОК"],

  "nbsp_rules": {
    "prepositions": ["в", "на", "по", "за", "из", "от", "к", "с", "у", "о", "об", "до", "при", "для", "без", "над", "под", "про", "через"],
    "patterns": ["№", "ст."],
    "initials_before_surname": true
  },

  "thresholds": {
    "rewrite_format_issues": 5,
    "rewrite_content_issues": 3,
    "max_versions": 10
  },

  "versioning": {
    "pattern": "{base_name}_v{version}",
    "initial_version": 1
  },

  "encryption": {
    "password_env_var": "DOC_DEFAULT_PASSWORD"
  },

  "pdf_conversion": {
    "command": "libreoffice",
    "args": ["--headless", "--norestore", "--convert-to", "pdf", "--outdir"],
    "timeout_seconds": 120
  },

  "work_dir": "/dev/shm/doc-review",

  "analysis": {
    "tolerance_pt": 0.5,
    "tolerance_cm": 0.1,
    "max_file_size_mb": 50
  },

  "doc_types": {
    "spravka": {
      "title_keyword": "Справка",
      "header_left_prefix": "Справка",
      "body_blocks": ["resume", "details", "conclusions"],
      "block_labels": {
        "resume": "Резюме",
        "details": "Детальная часть",
        "conclusions": "Выводы"
      },
      "conclusions_style": "normal",
      "conclusions_markers": ["в связи с изложенным", "считаю целесообразным", "на основании изложенного", "таким образом", "в связи с вышеизложенным"]
    },
    "sz": {
      "title_keyword": "Служебная записка",
      "header_left_prefix": "Служебная записка",
      "body_blocks": ["intro", "details", "conclusion"],
      "block_labels": {
        "intro": "Вводная часть",
        "details": "Детальная часть",
        "conclusion": "Заключение"
      },
      "conclusions_style": "italic",
      "conclusion_requires_deadline": true,
      "conclusions_markers": ["в связи с изложенным", "прошу вас", "прошу в срок", "на основании вышеизложенного прошу", "прошу рассмотреть"]
    }
  }
}
